# --- Core ---
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/lff-accommodation
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma separated list of allowed browser origins. The first one is used to build visitor profile links.
CLIENT_URL=http://localhost:3000

# --- Business rules ---
BOOKING_CODE_PREFIX=LFF
PAYSTACK_HOLD_MINUTES=30
BANK_TRANSFER_HOLD_MINUTES=180
REMINDER_HOURS=5
PROFILE_EXPIRY_HOURS=12

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# --- Pusher (Channels) ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=mt1

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM=LFF Accommodation <accommodation@yourdomain.com>

# --- Cron: call GET /api/cron/process every 10-15 min from an external scheduler (e.g. cron-job.org) with header "Authorization: Bearer <CRON_SECRET>" ---
CRON_SECRET=change-me-too

# --- Seed (first admin) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Church Admin
